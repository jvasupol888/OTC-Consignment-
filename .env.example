# ============================================================
# OTC Consignment — Environment Variables (template)
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามสภาพแวดล้อมจริง
#   cp .env.example .env
# ห้าม commit ไฟล์ .env จริงลง git (อยู่ใน .gitignore แล้ว)
# ============================================================

# ---------- Database (PostgreSQL) ----------
# ใช้ร่วมกันโดย apps/api และ packages/db
DATABASE_URL=postgresql://otc:otc@localhost:5432/otc_consignment

# ---------- API Server ----------
API_PORT=3001
NODE_ENV=development
# origin ที่อนุญาตให้เรียก API (คั่นด้วย comma)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ---------- Auth (JWT) ----------
# สร้างค่าใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Object Storage (S3 / MinIO) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=otc-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# MinIO ต้องใช้ path-style URL (true); AWS S3 ตั้งเป็น false
S3_FORCE_PATH_STYLE=true
# อายุของ presigned URL (วินาที)
S3_PRESIGN_TTL=300

# ---------- Seed / Bootstrap ----------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin1234

# ---------- Frontend (Next.js Admin) ----------
# ไฟล์จริงอยู่ที่ apps/admin/.env.local
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------- Mobile (Expo) ----------
# ไฟล์จริงอยู่ที่ apps/mobile/.env
EXPO_PUBLIC_API_URL=http://localhost:3001
