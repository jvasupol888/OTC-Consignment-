{
  "name": "otc-consignment",
  "version": "0.1.0",
  "private": true,
  "description": "ระบบฝากขาย OTC — PostgreSQL + NestJS + Next.js + React Native (monorepo)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @otc/db generate",
    "db:migrate": "pnpm --filter @otc/db migrate",
    "db:seed": "pnpm --filter @otc/db seed",
    "db:studio": "pnpm --filter @otc/db studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
